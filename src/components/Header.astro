<header class="sticky top-0 z-30">
  <div class="bg-[var(--cu-nav-bg)] py-1 text-[11px] text-[var(--cu-nav-text)]">
    <div class="stack-shell flex items-center justify-between gap-3">
      <span>📞 +212 5XX-XXXXXX | ✉ contact@stackcore.ma</span>
      <div class="flex gap-3">
        <span>🚚 Livraison 24-48h</span>
        <span>🇲🇦 MAD | 🇫🇷 FR</span>
      </div>
    </div>
  </div>

  <div class="border-b border-[var(--cu-border)] bg-white py-3">
    <div class="stack-shell flex items-center gap-4">
      <a href="/" class="shrink-0 text-[24px] font-bold text-[var(--cu-primary)]">StackCore</a>
      <form action="/catalogue" class="flex flex-1">
        <input
          type="text"
          name="q"
          class="w-full rounded-l border border-r-0 border-[#cfcfcf] px-3 py-2 text-[13px] outline-none focus:border-[var(--cu-primary)]"
          placeholder="Rechercher un produit, une marque..."
        />
        <button class="stack-btn stack-btn--cta rounded-l-none">Rechercher</button>
      </form>
      <nav class="flex items-center gap-4 text-[11px] text-[var(--cu-text-secondary)]">
        <a href="/compte/profil" class="hover:text-[var(--cu-primary)]">👤 Mon compte</a>
        <a href="/panier" class="relative hover:text-[var(--cu-primary)]">🛒 Panier <span class="absolute -right-3 -top-2 flex h-4 w-4 items-center justify-center rounded-full bg-red-500 text-[10px] text-white">0</span></a>
      </nav>
    </div>
  </div>

  <nav class="bg-[var(--cu-primary)] py-2 text-[12px] font-semibold text-white">
    <div class="stack-shell flex flex-wrap items-center gap-5">
      <a href="/catalogue" class="hover:underline">Composants PC</a>
      <a href="/catalogue" class="hover:underline">Gaming</a>
      <a href="/catalogue" class="hover:underline">Smartphones</a>
      <a href="/catalogue" class="hover:underline">Reconditionné</a>
      <a href="/catalogue" class="hover:underline">Promotions</a>
    </div>
  </nav>
</header>
