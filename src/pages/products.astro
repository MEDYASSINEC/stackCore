---
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/Header.astro';
---
<MainLayout title="Catalogue | StackCore"><Header /><main class="mx-auto max-w-7xl p-6"><section class="premium-card p-5"><h1 class="text-3xl font-bold">Catalogue</h1><div class="mt-4 grid gap-3 sm:grid-cols-3"><input id="q" class="input-premium" placeholder="Recherche en temps réel"/><input id="category" class="input-premium" placeholder="Catégorie"/><button id="search" class="btn-primary">Filtrer</button></div></section><section id="list" class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3"></section><div class="mt-4 flex justify-between"><button id="prev" class="btn-primary">Précédent</button><button id="next" class="btn-primary">Suivant</button></div></main></MainLayout>
<script>
let page=1;async function load(){const q=document.getElementById('q').value;const category=document.getElementById('category').value;const res=await fetch(`/api/products?page=${page}&limit=6&q=${encodeURIComponent(q)}&category=${encodeURIComponent(category)}`);const {data,meta}=await res.json();document.getElementById('list').innerHTML=data.map(p=>`<article class='premium-card p-4'><h2 class='font-semibold'>${p.name}</h2><p class='text-sm text-slate-500'>${p.description}</p><p class='mt-2 font-bold'>€${p.price}</p><button data-id='${p.id}' data-name='${p.name}' data-price='${p.price}' class='btn-primary mt-3 w-full add'>Ajouter</button></article>`).join('');document.querySelectorAll('.add').forEach(b=>b.addEventListener('click',()=>{const cart=JSON.parse(localStorage.getItem('stackcore-cart')||'{"state":{"items":[]},"version":0}');const item={productId:b.dataset.id,name:b.dataset.name,price:Number(b.dataset.price),quantity:1};const found=cart.state.items.find(i=>i.productId===item.productId);if(found){found.quantity+=1;}else{cart.state.items.push(item);}localStorage.setItem('stackcore-cart',JSON.stringify(cart));}));document.getElementById('prev').disabled=page<=1;document.getElementById('next').disabled=page>=meta.totalPages;}
document.getElementById('search').addEventListener('click',()=>{page=1;load();});document.getElementById('q').addEventListener('input',()=>{page=1;load();});document.getElementById('prev').addEventListener('click',()=>{page--;load();});document.getElementById('next').addEventListener('click',()=>{page++;load();});load();
</script>
