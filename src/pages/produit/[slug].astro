---
import MainLayout from '../../layouts/MainLayout.astro';
import Header from '../../components/Header.astro';
import { prisma } from '../../lib/prisma';

export async function getStaticPaths() {
  const products = await prisma.product.findMany({ select: { slug: true } });
  return products.map((product) => ({ params: { slug: product.slug } }));
}

const { slug } = Astro.params;
const product = slug ? await prisma.product.findUnique({ where: { slug } }) : null;
if (!product) {
  return Astro.redirect('/catalogue');
}
---
<MainLayout title={`${product.name} | StackCore`}>
  <Header />
  <main class="stack-shell py-4">
    <div class="stack-panel grid gap-4 p-4 md:grid-cols-[360px_1fr]">
      <div class="flex h-[320px] items-center justify-center bg-white p-3">
        <img src={product.imageUrl || '/favicon.svg'} alt={product.name} class="max-h-full max-w-full object-contain" />
      </div>
      <div>
        <p class="text-[11px] uppercase text-[var(--cu-text-muted)]">{product.brand || 'STACKCORE'}</p>
        <h1 class="text-[22px] font-bold">{product.name}</h1>
        <p class="mt-2 text-[13px] text-[var(--cu-text-secondary)]">{product.description || 'Description indisponible.'}</p>
        <p class="mt-4 text-[22px] font-bold text-[var(--cu-price)]">{Number(product.price).toFixed(2)} MAD</p>
      </div>
    </div>
  </main>
</MainLayout>
