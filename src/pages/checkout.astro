---
import MainLayout from '../layouts/MainLayout.astro'; import Header from '../components/Header.astro';
---
<MainLayout title="Checkout | StackCore"><Header /><main class="mx-auto max-w-3xl p-6"><section class="premium-card p-6"><h1 class="text-3xl font-bold">Panier & Checkout</h1><div id="cart"></div><p id="msg" class="mt-3 text-sm"></p><button id="pay" class="btn-primary mt-4">Payer (simulé)</button></section></main></MainLayout>
<script>
const auth=JSON.parse(localStorage.getItem('stackcore-auth')||'{}')?.state;const cart=JSON.parse(localStorage.getItem('stackcore-cart')||'{"state":{"items":[]}}');const el=document.getElementById('cart');el.innerHTML=cart.state.items.map(i=>`<div class='flex justify-between border-b py-2'><span>${i.name} x${i.quantity}</span><span>€${(i.price*i.quantity).toFixed(2)}</span></div>`).join('')||'<p>Panier vide</p>';document.getElementById('pay').addEventListener('click',async()=>{const res=await fetch('/api/orders',{method:'POST',headers:{'content-type':'application/json','authorization':`Bearer ${auth?.accessToken||''}`},body:JSON.stringify({items:cart.state.items.map(i=>({productId:i.productId,quantity:i.quantity})),paymentMethod:'SIMULATED'})});const data=await res.json();document.getElementById('msg').textContent=res.ok?'Paiement réussi + points fidélité crédités':'Erreur: '+(data.error||'checkout');if(res.ok){localStorage.setItem('stackcore-cart',JSON.stringify({state:{items:[]},version:0}));}})
</script>
